{
  "schema": 1,
  "extensionId": "org.fleet.discord",
  "pages": [
    {
      "id": "notify",
      "title": "Discord",
      "route": "/ext/org.fleet.discord/notify"
    }
  ],
  "actions": [
    {
      "id": "test-message",
      "label": "Send test message",
      "target": "global",
      "primary": true
    },
    {
      "id": "scan-now",
      "label": "Scan now",
      "target": "global"
    }
  ],
  "panels": [
    {
      "id": "discord-settings",
      "title": "Discord",
      "placement": "settings"
    }
  ],
  "forms": [
    {
      "id": "discord-settings",
      "title": "Discord notifications",
      "fields": [
        {
          "name": "enabled",
          "label": "Enabled",
          "kind": "boolean",
          "help": "Master switch for this worker."
        },
        {
          "name": "webhookURL",
          "label": "Webhook URL (leave blank to keep)",
          "kind": "text"
        },
        {
          "name": "clearWebhook",
          "label": "Clear stored webhook",
          "kind": "boolean"
        },
        {
          "name": "mention",
          "label": "Optional user mention ID",
          "kind": "text"
        },
        {
          "name": "notifyAdded",
          "label": "Notify on addition",
          "kind": "boolean"
        },
        {
          "name": "notifyFinished",
          "label": "Notify on finish",
          "kind": "boolean"
        },
        {
          "name": "notifyRemoved",
          "label": "Notify on removal",
          "kind": "boolean"
        },
        {
          "name": "intervalSec",
          "label": "Scan interval (seconds)",
          "kind": "number",
          "required": true,
          "help": "How often the worker wakes up.",
          "placeholder": "60",
          "advanced": true
        },
        {
          "name": "templateAdded",
          "label": "Added template ({name} {hash} {size} {ratio})",
          "kind": "text",
          "placeholder": "{name} added ({size})",
          "advanced": true
        },
        {
          "name": "templateFinished",
          "label": "Finished template",
          "kind": "text",
          "placeholder": "{name} finished",
          "advanced": true
        },
        {
          "name": "templateRemoved",
          "label": "Removed template",
          "kind": "text",
          "placeholder": "{name} removed",
          "advanced": true
        }
      ],
      "description": "Webhook URL first; filters and templates stay tucked away until needed."
    }
  ]
}
